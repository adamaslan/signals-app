# Supabase — reads go straight from the browser to Supabase, no backend
# hop (see docs/backend-state-and-supabase-plan.md Part 2). Both values are
# safe in a client bundle: the anon key can only read what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Legacy FastAPI backend (local dev / CLI only, not used by the deployed
# site as of Phase 5) ---

# Backend URL for server-side fetches (next dev / next start only)
BACKEND_URL=http://localhost:8000

# Backend URL baked into the static build for client-side fetches.
# In `next dev`, leave unset — the /api rewrite proxy handles it instead.
NEXT_PUBLIC_API_URL=http://localhost:8000
