# Environment: "local" (in-memory cache, optional LLM) or "cloud" (Postgres, required LLM)
SIGNALS_ENV=local

# --- LLM providers (OpenRouter takes priority when set) ---

# OpenRouter — preferred provider; supports 200+ models via one key
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Any OpenRouter model slug (default: google/gemini-2.0-flash-001)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Gemini — used when OPENROUTER_API_KEY is not set
# Required in cloud mode, optional in local mode (falls back to rule-based)
GEMINI_API_KEY=your-gemini-api-key-here

# Postgres — required in cloud mode only
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/signals_db

# Output directory for local mode JSON results
OUTPUT_DIR=./output

# Log level
LOG_LEVEL=INFO
