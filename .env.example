# Environment: "local" (in-memory cache, optional LLM) or "cloud" (Postgres, required LLM)
SIGNALS_ENV=local

# Gemini LLM — required in cloud mode, optional in local mode (falls back to rule-based)
GEMINI_API_KEY=your-gemini-api-key-here

# Postgres — required in cloud mode only
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/signals_db

# Output directory for local mode JSON results
OUTPUT_DIR=./output

# Log level
LOG_LEVEL=INFO
